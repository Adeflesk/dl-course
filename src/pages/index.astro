---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import '../styles/global.css';

const lessons = await getCollection('lessons');
lessons.sort((a, b) => a.data.chapter - b.data.chapter);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Deep Learning from Scratch</title>
    <meta name="description" content="Tensors, autodiff, gradient descent, CNNs — built from first principles in C++. A complete deep learning framework course with interactive diagrams." />
    <meta property="og:title" content="Deep Learning from Scratch" />
    <meta property="og:description" content="Tensors, autodiff, gradient descent, CNNs — built from first principles in C++." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body>
    <div style="position: absolute; top: 1.5rem; right: 2rem;">
      <a href="/about" style="color: var(--text-dim); text-decoration: none; font-size: 0.95rem; font-family: var(--font-mono); transition: color 0.2s;">
        [ About & Source Code ]
      </a>
    </div>

    <div class="hero animate-fade-in">
      <h1>Deep Learning<br />From First Principles</h1>
      <p class="subtitle" style="max-width: 800px; margin: 0 auto; line-height: 1.6;">
        Most deep learning courses teach you how to use PyTorch. This course teaches you how to <i>build</i> PyTorch. You will construct a complete, production-ready C++ AI framework from absolute zero—no external libraries allowed. By the end, your custom engine will train CNNs and generate text with a Transformer.
      </p>
      
      <div class="course-specs" style="display: flex; gap: 3rem; text-align: left; margin: 2.5rem auto 3.5rem auto; justify-content: center; font-size: 0.95rem;">
        <div>
          <strong style="color: var(--text); display: block; margin-bottom: 0.5rem; font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">For:</strong>
          <ul style="color: var(--text-dim); padding-left: 1.2rem; line-height: 1.6;">
            <li>Intermediate developers</li>
            <li>Software engineers entering AI</li>
            <li>Anyone tired of "black box" ML</li>
          </ul>
        </div>
        <div>
          <strong style="color: var(--text); display: block; margin-bottom: 0.5rem; font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Includes:</strong>
          <ul style="color: var(--text-dim); padding-left: 1.2rem; line-height: 1.6;">
            <li>Full Autodiff engine in C++</li>
            <li>Interactive visual diagrams</li>
            <li>MNIST CNN & MiniGPT capstones</li>
          </ul>
        </div>
      </div>

      <a href="/lessons/00-the-big-picture" class="cta">Start the Course →</a>
    </div>

    <div class="chapter-grid animate-stagger">
      {lessons.map(lesson => (
        <a href={`/lessons/${lesson.id}`} class="chapter-card" style={lesson.data.chapter % 1 !== 0 ? "border-left: 2px solid var(--accent); background: var(--bg-border);" : ""}>
          <div class="chapter-num" style={lesson.data.chapter % 1 !== 0 ? "font-size: 1.2rem; margin-bottom: 0.5rem; opacity: 0.8;" : ""}>
            {lesson.data.chapter % 1 !== 0 ? "Deep Dive" : String(lesson.data.chapter).padStart(2, '0')}
          </div>
          <h3>{lesson.data.title}</h3>
          <p>{lesson.data.description}</p>
        </a>
      ))}
    </div>
  </body>
</html>
